{
    "compilerOptions": {
        "module": "ESNext",
        "moduleResolution": "bundler",
        "lib": ["ES2022"],
        // explicit: TS 6+ defaults to strict:true and stops auto-including @types/*
        "strict": false,
        "types": ["node"],
        "experimentalDecorators": true,
        "noImplicitAny": true,
        "noImplicitThis": true,
        "inlineSources": true,
        "sourceMap": true
    },
    "include": [
      "../src/**/*.ts"
    ],
    "exclude": [
      "../src/bench_*.ts"
    ]
}
