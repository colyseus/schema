// Mirrors the tsconfig create-colyseus-app generates: strict on, but
// strictNullChecks off (and skipLibCheck on, as such consumers set it).
{
  "compilerOptions": {
    "target": "ESNext",
    "lib": ["ESNext"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "noEmit": true,
    "types": []
  },
  "files": ["test/SchemaTypeOptionality.nostrict.types.ts"]
}
