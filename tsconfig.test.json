{
  "extends": "./tsconfig/tsconfig.all.json",
  "compilerOptions": {
    "module": "Preserve",
    "target": "ES2022",
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["node", "mocha"],
    "experimentalDecorators": true,
    "useDefineForClassFields": false
  },
  "include": [
    "src/**/*.ts",
    "test/**/*.ts"
  ],
  "exclude": [
    "build",
    "test/**/*.types.ts",
    "test/ChangeAPI._test.ts"
  ]
}
